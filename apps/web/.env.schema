# The single source of truth for this app's configuration.
# Read values with `import { ENV } from "varlock/env"`, never `process.env`.
#
# @defaultSensitive=true
# @generateTsTypes(path=./src/env.d.ts, processEnv=none, importMetaEnv=none)
# @encryptInjectedEnv=$VERCEL
# ---

# Set by Vercel at build time and runtime. Gates local-only defaults.
# @required @internal @type=boolean @sensitive=false
VERCEL=false

# Postgres. Locally, each checkout gets its own database (packages/db/scripts/local.ts).
# @required @type=url(allowedProtocols=[postgresql, postgres])
DATABASE_URL=if($VERCEL, "", exec(`bun "$(git rev-parse --show-toplevel)/packages/db/scripts/local.ts" url`))
