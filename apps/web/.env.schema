# Runtime configuration for the web app. Declare every env var here and read
# it with `import { ENV } from "varlock/env"`. Put local values in .env.local.
# @defaultSensitive=true
# @generateTsTypes(path=./src/env.d.ts, processEnv=none, importMetaEnv=none)
# Deployments bake the resolved env into the server build; encrypt it there
# with each Vercel environment's _VARLOCK_ENV_KEY (see scripts/sync-vercel-env.ts).
# @encryptInjectedEnv=$VERCEL
# ---

# Set by Amp inside an orb, where the dev server must accept portal hostnames.
# @type=boolean @sensitive=false
AMP_ORB=false

# Set by Vercel in deployments, where local defaults must not apply.
# @internal @type=boolean @sensitive=false
VERCEL=false

# Hostnames Vercel sets for each deployment: the production domain, the
# branch alias, and the deployment's own URL.
# @internal @sensitive=false @optional
VERCEL_PROJECT_PRODUCTION_URL=
# @internal @sensitive=false @optional
VERCEL_BRANCH_URL=
# @internal @sensitive=false @optional
VERCEL_URL=

# exec() runs in the caller's working directory, so locate scripts from the root.
# Unused in deployments, which may build without git metadata.
# @internal @sensitive=false @optional
_REPO_ROOT=if($VERCEL, "", exec(`git rev-parse --show-toplevel`))

# Postgres connection string. Locally it defaults to this checkout's own
# database on the dev server; see packages/db/scripts/local-database-url.ts.
# Deployments must set it, using a transaction-mode pooled URL on serverless.
# The web app hands it to the API layer; packages/db tooling reads it too.
# @required @type=url(allowedProtocols=[postgresql])
DATABASE_URL=if($VERCEL, "", exec(`bun ${_REPO_ROOT}/packages/db/scripts/local-database-url.ts`))

# Signs sessions. Deployments must set 32+ random characters
# (`bunx varlock generate-key --plain`). Locally any stable value works, so it is
# derived from the checkout path rather than stored anywhere.
# @required @type=string(minLength=32)
BETTER_AUTH_SECRET=if($VERCEL, "", "local-only-not-for-production:${_REPO_ROOT}")

# Comma-separated hosts the app is served from. Better Auth builds its URLs
# from the request's host when it matches one: Portless URLs, worktrees, and
# Amp portals locally; the deployment's Vercel hostnames when deployed. Set it
# on Vercel only to add another domain.
# @required @sensitive=false
BETTER_AUTH_ALLOWED_HOSTS=if($VERCEL, "${VERCEL_PROJECT_PRODUCTION_URL},${VERCEL_BRANCH_URL},${VERCEL_URL}", "localhost,*.localhost,*.onamp.dev")
