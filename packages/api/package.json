{
  "name": "@app/api",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/router.ts",
    "./auth": "./src/auth.ts",
    "./schema": "./src/schema.ts"
  },
  "scripts": {
    "auth:schema": "auth generate --config auth.config.ts --output ../db/src/schema/auth.ts --yes && biome format --write ../db/src/schema/auth.ts",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@app/db": "workspace:*",
    "@orpc/contract": "catalog:",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "better-auth": "catalog:",
    "evlog": "catalog:",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "auth": "^1.7.12",
    "typescript": "catalog:"
  }
}
