{
  "name": "@app/db",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "db:generate": "varlock run -- drizzle-kit generate",
    "db:migrate": "varlock run -- bun scripts/migrate.ts",
    "db:reset": "varlock run -- bun scripts/migrate.ts --reset",
    "db:studio": "varlock run -- drizzle-kit studio"
  },
  "dependencies": {
    "better-auth": "catalog:",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "typescript": "catalog:",
    "varlock": "catalog:"
  },
  "varlock": {
    "loadPath": "../../apps/web/"
  }
}
