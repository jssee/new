{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/biome/core", "ultracite/biome/svelte"],
  "overrides": [
    {
      // shadcn-svelte primitives are generated by its CLI and updated by
      // re-running it, so they keep upstream conventions instead of ours.
      "includes": [
        "apps/web/src/lib/components/ui/**",
        "apps/web/src/lib/utils.ts"
      ],
      "linter": { "enabled": false }
    }
  ]
}
