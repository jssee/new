{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/biome/core", "ultracite/biome/svelte"],
  "overrides": [
    {
      // Keeps the architecture: the web app reaches the API only through
      // remote functions, and the database only through the API.
      "includes": ["apps/web/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@app/db", "@app/db/*", "**/server/db*"],
                    "message": "The web app reaches the database only through the API: call a procedure from a remote function."
                  },
                  {
                    "group": ["@app/api", "@app/api/*", "**/server/api*"],
                    "message": "Call API procedures only from remote functions (*.remote.ts)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      // Remote functions and the OpenAPI endpoint are the API's two ways in.
      "includes": ["apps/web/**/*.remote.ts", "apps/web/src/routes/api/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@app/db", "@app/db/*", "**/server/db*"],
                    "message": "The web app reaches the database only through the API: call a procedure instead."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      // The server wiring that hands the db to Better Auth and the API.
      "includes": [
        "apps/web/src/lib/server/api.ts",
        "apps/web/src/lib/server/auth.ts",
        "apps/web/src/lib/server/db.ts"
      ],
      "linter": { "rules": { "style": { "noRestrictedImports": "off" } } }
    },
    {
      // Generated files come after the rule overrides so disabling the linter
      // wins for them.
      //
      // Generated by the shadcn-svelte and Better Auth CLIs and updated by
      // re-running them, so they keep upstream conventions instead of ours.
      "assist": { "enabled": false },
      "includes": [
        "apps/web/src/lib/components/ui/**",
        "apps/web/src/lib/utils.ts",
        "packages/db/src/schema/auth.ts"
      ],
      "linter": { "enabled": false }
    },
    {
      // Written by drizzle-kit and never edited by hand.
      "assist": { "enabled": false },
      "formatter": { "enabled": false },
      "includes": ["packages/db/migrations/**"],
      "linter": { "enabled": false }
    }
  ]
}
