{
  "name": "app",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "typescript": "^6.0.3",
      "varlock": "^1.23.0"
    }
  },
  "scripts": {
    "build": "bun run --filter @app/web build",
    "check": "ultracite check && bun run --filter './apps/*' --filter './packages/*' check",
    "db:generate": "bun run --filter @app/db db:generate",
    "db:migrate": "bun run --filter @app/db db:migrate",
    "db:reset": "bun run --filter @app/db db:reset",
    "db:studio": "bun run --filter @app/db db:studio",
    "dev": "bun run --filter @app/web dev",
    "fix": "ultracite fix",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "lefthook": "^2.2.2",
    "ultracite": "8.0.2",
    "varlock": "catalog:"
  },
  "packageManager": "bun@1.4.4"
}
