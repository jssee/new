{
  "name": "app",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --filter @app/web build",
    "check": "ultracite check && bun run --filter './apps/*' --filter './packages/*' check",
    "dev": "bun run --filter @app/web dev",
    "fix": "ultracite fix",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "lefthook": "^2.2.2",
    "ultracite": "8.0.2",
    "varlock": "^1.23.0"
  },
  "packageManager": "bun@1.4.4"
}
