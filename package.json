{
  "name": "app",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@orpc/contract": "2.0.0-beta.45",
      "@orpc/openapi": "2.0.0-beta.45",
      "@orpc/server": "2.0.0-beta.45",
      "@orpc/valibot": "2.0.0-beta.45",
      "better-auth": "^1.7.12",
      "drizzle-orm": "^0.45.4",
      "evlog": "^2.33.1",
      "typescript": "^6.0.3",
      "valibot": "^1.5.0",
      "varlock": "^1.23.0"
    }
  },
  "scripts": {
    "build": "bun run --filter @app/web build",
    "check": "ultracite check && bun run --filter './apps/*' --filter './packages/*' check",
    "db:generate": "bun run --filter @app/db db:generate",
    "db:migrate": "bun run --filter @app/db db:migrate",
    "db:reset": "bun run --filter @app/db db:reset",
    "db:studio": "bun run --filter @app/db db:studio",
    "deploy:logs": "bun scripts/deploy-logs.ts",
    "deploy:setup": "vercel link",
    "dev": "bun run --cwd apps/web dev",
    "env:preview": "bun scripts/sync-vercel-env.ts preview",
    "env:production": "bun scripts/sync-vercel-env.ts production",
    "fix": "ultracite fix",
    "prepare": "git rev-parse --git-dir > /dev/null 2>&1 || exit 0; lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "lefthook": "^2.2.2",
    "ultracite": "8.0.2",
    "varlock": "catalog:",
    "vercel": "^65.2.0"
  },
  "packageManager": "bun@1.4.4"
}
