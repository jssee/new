{
  "name": "myapp",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@orpc/contract": "2.0.0-beta.46",
      "@orpc/openapi": "2.0.0-beta.46",
      "@orpc/server": "2.0.0-beta.46",
      "@orpc/valibot": "2.0.0-beta.46",
      "@varlock/vite-integration": "^1.5.4",
      "evlog": "^2.34.0",
      "typescript": "^6.0.3",
      "valibot": "^1.5.0",
      "varlock": "^1.23.0"
    }
  },
  "scripts": {
    "build": "bun run --cwd apps/web build",
    "check": "ultracite check && tsc --noEmit -p tsconfig.json && bun run --elide-lines=0 --filter './apps/*' --filter './packages/*' check",
    "db:generate": "bun run --cwd packages/db db:generate",
    "db:migrate": "bun run --cwd packages/db db:migrate",
    "db:prune": "bun run --cwd packages/db db:prune",
    "db:push": "bun run --cwd packages/db db:push",
    "db:rehearse": "bun run --cwd packages/db db:rehearse",
    "db:stop": "bun run --cwd packages/db db:stop",
    "db:studio": "bun run --cwd packages/db db:studio",
    "dev": "bun run --cwd apps/web dev",
    "env:check": "bun run --cwd apps/web env:check",
    "fix": "ultracite fix",
    "setup": "bun install && bun run db:push"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "^24.19.2",
    "lefthook": "^2.2.2",
    "portless": "0.15.12",
    "typescript": "catalog:",
    "ultracite": "8.1.0",
    "varlock": "catalog:"
  },
  "packageManager": "bun@1.4.4"
}
